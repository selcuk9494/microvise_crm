{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "{assets/**,api/_lib/**}",
      "maxDuration": 60
    },
    "api/auth/*.js": {
      "includeFiles": "{assets/**,api/_lib/**}",
      "maxDuration": 60
    },
    "api/dashboard/*.js": {
      "includeFiles": "{assets/**,api/_lib/**}",
      "maxDuration": 60
    },
    "api/personnel/*.js": {
      "includeFiles": "{assets/**,api/_lib/**}",
      "maxDuration": 60
    },
    "api/akinsoft/*.js": {
      "includeFiles": "{assets/**,api/_lib/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/me?health=1" },
    { "source": "/api/tsm-log", "destination": "/api/mutate?op=parseTsmLog" },
    { "source": "/p/:token", "destination": "/api/invoice-pay?token=:token" },
    { "source": "/pay/:token", "destination": "/api/invoice-pay?token=:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

